    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": ["obsidian", "plugin", "gallery"],
  "author": "DuranceX",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
