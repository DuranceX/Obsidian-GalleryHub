{
  "name": "obsidian-gallery-hub",
  "version": "0.13.1",
  "description": "GalleryHub - art asset gallery plugin for Obsidian (images / videos / links with AI-gen prompt metadata)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
